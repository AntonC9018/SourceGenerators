<Project>
    <ItemGroup Condition="'$(IsSourceGenerator)' == 'true'">
        <!--
          Reference PolySharp for all .NET Standard 2.0 polyfills.
          Only needed for source generators.
        -->
        <PackageReference Include="PolySharp" Version="1.14.1">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>build;analyzers</IncludeAssets>
        </PackageReference>

        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference
            Include="Microsoft.CodeAnalysis.CSharp"
            Version="4.10.0"
            PrivateAssets="all" />
    </ItemGroup>

    <PropertyGroup>
        <SourceGenerationProject>$(MSBuildThisFileDirectory)..\source\SourceGeneration\SourceGeneration.csproj</SourceGenerationProject>
        <UtilsSharedProject>$(MSBuildThisFileDirectory)..\source\Utils.Shared\Utils.Shared.csproj</UtilsSharedProject>
    </PropertyGroup>

    <PropertyGroup Condition="'$(IsSourceGenerator)' == 'true' or '$(IsTests)' == 'true'">
        <ProjectBaseName>$([System.String]::Copy($(MSBuildProjectName)).Substring(0, $([System.String]::Copy($(MSBuildProjectName)).IndexOf('.'))))</ProjectBaseName>
        <OwnSharedProject>$(MSBuildProjectDirectory)\..\Shared\$(ProjectBaseName).Shared.csproj</OwnSharedProject>
    </PropertyGroup>

    <ItemDefinitionGroup>
        <SourceGenerationProjectReference>
            <IncludeInConsumerPackage>false</IncludeInConsumerPackage>
        </SourceGenerationProjectReference>
    </ItemDefinitionGroup>

    <ItemGroup Condition="'$(IsSourceGenerator)' == 'true'">
        <SourceGenerationProjectReference Include="$(SourceGenerationProject)" />
        <SourceGenerationProjectReference
            Include="$(UtilsSharedProject)"
            IncludeInConsumerPackage="true" />
        <SourceGenerationProjectReference
            Condition="Exists('$(OwnSharedProject)')"
            Include="$(OwnSharedProject)"
            IncludeInConsumerPackage="true" />
    </ItemGroup>

    <!--
      Generation-time dependencies are private compilation references. Their resolved copy-local
      project outputs are propagated to analyzer consumers and generator packages below.
    -->
    <ItemGroup Condition="'$(IsSourceGenerator)' == 'true'">
        <ProjectReference
            Include="@(SourceGenerationProjectReference)"
            KeepMetadata="IncludeInConsumerPackage">
            <PrivateAssets>all</PrivateAssets>
            <SourceGenerationProjectReference>true</SourceGenerationProjectReference>
        </ProjectReference>
    </ItemGroup>

    <PropertyGroup Condition="'$(IsSourceGenerator)' == 'true'">
        <BuildProjectReferences Condition="'$(NoBuild)' == 'true'">false</BuildProjectReferences>
        <GetTargetPathDependsOn>
            $(GetTargetPathDependsOn);
            ResolveSourceGenerationProjectReferences
        </GetTargetPathDependsOn>
        <TargetsForTfmSpecificContentInPackage>
            $(TargetsForTfmSpecificContentInPackage);
            AddSourceGenerationPackageFiles
        </TargetsForTfmSpecificContentInPackage>
    </PropertyGroup>

    <Target
        Name="ResolveSourceGenerationProjectReferences"
        Condition="'$(IsSourceGenerator)' == 'true'"
        DependsOnTargets="ResolveReferences"
        AfterTargets="ResolveReferences">
        <ItemGroup>
            <_SourceGenerationAnalyzerDependency
                Include="@(ReferenceCopyLocalPaths)"
                Condition="
                    '%(ReferenceCopyLocalPaths.ReferenceSourceTarget)' == 'ProjectReference' and
                    '%(ReferenceCopyLocalPaths.Extension)' == '.dll'" />

            <TargetPathWithTargetPlatformMoniker
                Include="@(_SourceGenerationAnalyzerDependency)"
                KeepDuplicates="false">
                <IncludeRuntimeDependency>false</IncludeRuntimeDependency>
            </TargetPathWithTargetPlatformMoniker>
        </ItemGroup>
    </Target>

    <Target
        Name="AddSourceGenerationPackageFiles"
        Condition="'$(IsSourceGenerator)' == 'true'"
        DependsOnTargets="ResolveSourceGenerationProjectReferences">
        <ItemGroup>
            <TfmSpecificPackageFile Include="$(TargetPath)">
                <PackagePath>analyzers/dotnet/cs</PackagePath>
            </TfmSpecificPackageFile>
            <TfmSpecificPackageFile Include="@(_SourceGenerationAnalyzerDependency)">
                <PackagePath>analyzers/dotnet/cs</PackagePath>
            </TfmSpecificPackageFile>

            <_SourceGenerationConsumerLibrary
                Include="@(_SourceGenerationAnalyzerDependency)"
                Condition="'%(_SourceGenerationAnalyzerDependency.IncludeInConsumerPackage)' == 'true'" />
            <TfmSpecificPackageFile Include="@(_SourceGenerationConsumerLibrary)">
                <PackagePath>lib/netstandard2.0</PackagePath>
            </TfmSpecificPackageFile>
        </ItemGroup>
    </Target>

    <ItemGroup Condition="'$(IsTests)' == 'true'">
        <ProjectReference
            Condition="Exists('$(OwnSharedProject)')"
            Include="$(OwnSharedProject)" />
    </ItemGroup>

    <ItemGroup Condition="($(MSBuildProjectName.EndsWith('Shared')) and '$(MSBuildProjectName)' != 'Utils.Shared')">
        <ProjectReference Include="$(UtilsSharedProject)" />
    </ItemGroup>

    <ItemGroup Condition="'$(IsTests)' == 'true'">
        <PackageReference Include="Verify.Xunit" Version="26.2.0" />
        <PackageReference Include="Verify.SourceGenerators" Version="2.3.0" />
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" PrivateAssets="all" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.10.0" PrivateAssets="all" />
        <PackageReference Include="Basic.Reference.Assemblies" Version="1.7.2" />

        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
        <PackageReference Include="xunit" Version="2.9.0" />
        <PackageReference Include="xunit.runner.visualstudio" Version="2.8.1">
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
          <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="coverlet.collector" Version="6.0.2">
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
          <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup Condition="'$(IsTests)' == 'true'">
        <ProjectReference Include="$(MSBuildThisFileDirectory)..\source\SourceGeneration.Testing\SourceGeneration.Testing.csproj" />
    </ItemGroup>
</Project>
